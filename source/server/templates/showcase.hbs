{{!--
  Huaka: the public showcase ("vitrina"). Route: routes/views/showcase.ts. Styles and script: branding/css/showcase.css,
  branding/js/showcase.js. Each piece is presented as its inventory card: the hero card, the slips of the featured
  pieces, the catalogue tags of the recent ones.
  Behind every section, a fixed stage holds one piece per section (backdrops, chosen by the route); the script
  crossfades them as the sections pass. Without the script, the first one stays.
--}}
{{#if backdrops.hero}}
<div class="sc-stage" aria-hidden="true">
  {{#each backdrops}}
  <div class="sc-stage__layer" data-sc-layer="{{@key}}">
    <img src="{{image.medium}}" srcset="{{image.low}} 640w, {{image.medium}} 1280w, {{image.high}} 2560w" sizes="100vw"
      width="2560" height="2560" alt="" {{#if @first}}fetchpriority="high"{{else}}decoding="async"{{/if}}>
  </div>
  {{/each}}
</div>
{{/if}}
{{#if hero}}
<section class="sc-hero" aria-labelledby="sc-hero-title" data-sc-section="hero">
  {{!-- "Girar en 3D" opens the viewer here; the piece itself is on the stage --}}
  <div class="sc-hero__stage" data-sc-stage>
    {{#unless backdrops.hero}}{{#if hero.thumb}}
      <img class="sc-hero__photo" src="{{hero.thumb}}" width="320" height="320" alt="{{hero.title}}">
    {{/if}}{{/unless}}
  </div>
  <div class="sc-hero__card" data-sc-card>
    <h1 class="sc-hero__title" id="sc-hero-title" data-sc-words>{{#if brand}}{{brand}}{{else}}eCorpus{{/if}}</h1>
    <p class="sc-hero__lead">{{i18n "huaka.showcase.heroLead"}}</p>
    <dl class="sc-facts">
      <div><dt>{{i18n "huaka.showcase.piece"}}</dt><dd>{{hero.title}}</dd></div>
      {{#if hero.collection}}<div><dt>{{i18n "huaka.showcase.collection"}}</dt><dd>{{hero.collection}}</dd></div>{{/if}}
      <div><dt>{{i18n "huaka.showcase.updated"}}</dt><dd>{{dateString hero.mtime "date"}}</dd></div>
    </dl>
    <div class="sc-hero__actions">
      <a class="sc-btn" href="{{hero.viewUri}}" data-sc-rotate="{{hero.viewUri}}"
        data-sc-close-label="{{i18n "huaka.showcase.closeViewer"}}">{{i18n "huaka.showcase.rotate"}}</a>
      <a class="sc-link" href="/ui/scenes/">{{i18n "huaka.showcase.browse"}}</a>
    </div>
  </div>
</section>
{{else}}
<section class="sc-empty">
  <h1 class="sc-hero__title">{{#if brand}}{{brand}}{{else}}eCorpus{{/if}}</h1>
  <p class="sc-hero__lead">{{i18n "huaka.showcase.empty"}}</p>
</section>
{{/if}}

{{#if featured.length}}
<section class="sc-feat" aria-labelledby="sc-feat-title" data-sc-section="featured">
  <div class="sc-feat__text">
    <h2 class="sc-h2" id="sc-feat-title" data-sc-words>{{i18n "huaka.showcase.featuredTitle"}}</h2>
    <p class="sc-statement" data-sc-words>{{i18n "huaka.showcase.featuredLead"}}</p>
  </div>
  <ul class="sc-slips" role="list">
    {{#each featured}}
    <li class="sc-slip" data-sc-reveal>
      <a class="sc-slip__link" href="{{viewUri}}">
        {{#if image}}<img class="sc-slip__plate" src="{{image.low}}" width="640" height="640" alt="" loading="lazy">{{/if}}
        <strong class="sc-slip__title">{{title}}</strong>
        <span class="sc-slip__rule" aria-hidden="true">· · · · · · · · · · · ·</span>
        {{#if collection}}<span>{{i18n "huaka.showcase.collection"}}: {{collection}}</span>{{/if}}
        <span>{{i18n "huaka.showcase.updated"}}: {{dateString mtime "date"}}</span>
        <span class="sc-slip__go">{{i18n "huaka.showcase.rotate"}} →</span>
      </a>
    </li>
    {{/each}}
  </ul>
</section>
{{/if}}

{{#if recent.length}}
<section class="sc-recent" aria-labelledby="sc-recent-title" data-sc-section="recent">
  <div class="sc-recent__head">
    <h2 class="sc-h2" id="sc-recent-title" data-sc-words>{{i18n "huaka.showcase.recentTitle"}}</h2>
    <a class="sc-link" href="/ui/scenes/?orderBy=mtime&orderDirection=desc">{{i18n "huaka.showcase.browse"}}</a>
  </div>
  <ul class="sc-tiles" role="list">
    {{#each recent}}
    <li class="sc-tile" data-sc-reveal>
      <a class="sc-tile__link" href="{{uri}}">
        <span class="sc-tile__photo">
          {{#if image}}
            <img src="{{image.low}}" srcset="{{image.low}} 640w, {{image.medium}} 1280w"
              sizes="(max-width: 700px) 50vw, 25vw" width="640" height="640" alt="{{title}}" loading="lazy">
          {{else if thumb}}
            <img src="{{thumb}}" width="320" height="320" alt="{{title}}" loading="lazy">
          {{/if}}
        </span>
        <span class="sc-tile__tag">
          <span class="sc-tile__title">{{title}}</span>
          <span class="sc-tile__row">
            <span>{{#if collection}}{{collection}}{{else}}{{author}}{{/if}}</span>
            <time datetime="{{dateString mtime "iso"}}">{{dateString mtime "date"}}</time>
          </span>
        </span>
      </a>
    </li>
    {{/each}}
  </ul>
</section>
{{/if}}

{{#if collections.length}}
<section class="sc-colls" aria-labelledby="sc-colls-title" data-sc-section="collections">
  <div class="sc-colls__col">
  <h2 class="sc-giant" id="sc-colls-title" data-sc-words>{{i18n "huaka.showcase.collectionsWord"}}</h2>
  <div class="sc-bars">
    {{#each collections}}
    <details class="sc-bar" {{#if @first}}open{{/if}} data-sc-reveal>
      <summary class="sc-bar__summary">
        <span class="sc-bar__name">{{name}}</span>
        <span class="sc-bar__count">{{i18n "huaka.showcase.pieces" count=size}}</span>
        <span class="sc-bar__sign" aria-hidden="true"></span>
      </summary>
      <div class="sc-bar__panel">
        <ul class="sc-bar__items" role="list">
          {{#each scenes}}
          <li>
            <a href="{{uri}}">
              {{#if image}}<img src="{{image.low}}" width="640" height="640" alt="" loading="lazy">{{else if thumb}}<img src="{{thumb}}" width="320" height="320" alt="" loading="lazy">{{/if}}
              <span>{{title}}</span>
            </a>
            <time datetime="{{dateString mtime "iso"}}">{{dateString mtime "date"}}</time>
          </li>
          {{/each}}
        </ul>
        <a class="sc-link" href="{{uri}}">{{i18n "huaka.showcase.openCollection"}}</a>
      </div>
    </details>
    {{/each}}
  </div>
  </div>
</section>
{{/if}}

<section class="sc-about" aria-label="{{i18n "huaka.showcase.aboutLabel"}}" data-sc-section="about">
  <div class="sc-sheet" data-sc-reveal>
    <div class="sc-sheet__letter">
      {{{i18n "huaka.showcase.aboutLetter"}}}
      <p class="sc-sheet__sign">{{i18n "huaka.showcase.aboutSign"}}</p>
      <p class="sc-sheet__role">{{#if brand}}{{brand}}{{else}}eCorpus{{/if}}</p>
    </div>
    {{#if contact_email}}
    <div class="sc-sheet__stub">
      <span>{{contact_email}}</span>
      <a class="sc-btn" href="mailto:{{contact_email}}">{{i18n "huaka.showcase.writeUs"}}</a>
    </div>
    {{/if}}
  </div>
</section>
