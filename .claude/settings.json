{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git submodule update --init --recursive)",
      "Bash(npm run build-ui *)",
      "Bash(npm run build-server *)",
      "Bash(npm test *)",
      "Bash(docker compose config --quiet)",
      "Bash(tar -C branding -czf - .)",
      "Bash(ssh huaka-agent staging ps)",
      "Bash(ssh huaka-agent staging validate)",
      "Bash(ssh huaka-agent staging health)",
      "Bash(ssh huaka-agent staging logs *)",
      "Bash(ssh huaka-agent staging pull)",
      "Bash(ssh huaka-agent staging up)",
      "Bash(ssh huaka-agent staging restart)",
      "Bash(ssh huaka-agent staging put-branding)",
      "Bash(ssh huaka-agent prod ps)",
      "Bash(ssh huaka-agent prod validate)",
      "Bash(ssh huaka-agent prod health)",
      "Bash(ssh huaka-agent prod logs *)",
      "WebFetch(domain:ecorpus.eu)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rename *)",
      "Bash(docker push *)",
      "Bash(docker login *)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(**/.claude/skills/**)",
      "PowerShell(git push *)",
      "PowerShell(git rebase *)",
      "PowerShell(git merge *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(docker push *)",
      "PowerShell(docker login *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push upstream*)",
      "Bash(git push * upstream*)",
      "Bash(sudo *)",
      "Bash(ssh root@*)",
      "Bash(ssh * root@*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(ssh huaka-agent prod pull *)",
      "Bash(ssh huaka-agent prod up *)",
      "Bash(ssh huaka-agent prod restart *)",
      "Bash(ssh huaka-agent prod put-branding *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Edit(**/.claude/settings*.json)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push upstream*)",
      "PowerShell(git push * upstream*)",
      "PowerShell(ssh root@*)",
      "PowerShell(ssh * root@*)",
      "PowerShell(ssh huaka-agent prod pull *)",
      "PowerShell(ssh huaka-agent prod up *)",
      "PowerShell(ssh huaka-agent prod restart *)",
      "PowerShell(ssh huaka-agent prod put-branding *)"
    ]
  }
}
